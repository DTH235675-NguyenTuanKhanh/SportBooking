@model OwnerApprovalDetailViewModel
@{
    ViewData["Title"] = "Chi tiết hồ sơ chủ sân";
    var badge = Model.ApprovalStatus switch { OwnerApprovalStatus.Pending => "text-bg-warning", OwnerApprovalStatus.Approved => "text-bg-success", _ => "text-bg-danger" };
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Chi tiết hồ sơ chủ sân</h1><p class="text-muted mb-0">@Model.FullName · @Model.Email</p></div><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Danh sách</a></div>
    <div class="row g-4">
        <div class="col-lg-8"><div class="card p-4"><div class="d-flex justify-content-between"><h2 class="h5">Thông tin đăng ký</h2><span class="badge @badge">@Model.ApprovalStatus</span></div><dl class="row mb-0"><dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.FullName</dd><dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd><dt class="col-sm-4">Điện thoại</dt><dd class="col-sm-8">@Model.PhoneNumber</dd><dt class="col-sm-4">Ngày sinh</dt><dd class="col-sm-8">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</dd><dt class="col-sm-4">Địa chỉ</dt><dd class="col-sm-8">@Model.Address</dd><dt class="col-sm-4">Tên doanh nghiệp</dt><dd class="col-sm-8">@Model.BusinessName</dd><dt class="col-sm-4">Điện thoại kinh doanh</dt><dd class="col-sm-8">@Model.BusinessPhone</dd><dt class="col-sm-4">Ngày đăng ký</dt><dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-4">Dữ liệu hiện có</dt><dd class="col-sm-8">@Model.ComplexCount cụm sân · @Model.CourtCount sân</dd></dl>
        @if (!string.IsNullOrWhiteSpace(Model.ApprovalRejectionReason)) { <div class="alert alert-danger mt-3 mb-0"><strong>Lý do từ chối:</strong> @Model.ApprovalRejectionReason</div> }
        </div></div>
        <div class="col-lg-4"><div class="card p-4"><h2 class="h5">Xử lý yêu cầu</h2>@if (Model.ApprovalStatus == OwnerApprovalStatus.Pending) { <form asp-action="Decide" method="post" id="decisionForm"><input type="hidden" name="UserId" value="@Model.Id" /><input type="hidden" name="Decision" id="Decision" /><div class="mb-3"><label class="form-label" for="RejectionReason">Lý do từ chối (bắt buộc khi từ chối)</label><textarea class="form-control" name="RejectionReason" id="RejectionReason" rows="4" maxlength="1000"></textarea></div><div class="d-flex gap-2"><button type="submit" class="btn btn-success" onclick="document.getElementById('Decision').value='Approved'"><i class="bi bi-check-lg"></i> Duyệt</button><button type="submit" class="btn btn-outline-danger" onclick="if (!document.getElementById('RejectionReason').value.trim()) { alert('Vui lòng nhập lý do từ chối.'); return false; } document.getElementById('Decision').value='Rejected'"><i class="bi bi-x-lg"></i> Từ chối</button></div></form> } else { <p class="text-muted mb-0">Yêu cầu đã được xử lý vào @(Model.ApprovalReviewedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—").</p> }</div></div>
    </div>
</div>
