@model AdminUserListViewModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var routeValues = new Dictionary<string, string?>
    {
        ["RoleFilter"] = Model.RoleFilter,
        ["StatusFilter"] = Model.StatusFilter,
        ["Keyword"] = Model.Keyword,
        ["PageSize"] = Model.PageSize.ToString()
    };
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-people text-primary"></i> Quản lý tài khoản</h1>
            <p class="text-muted mb-0">Theo dõi vai trò và trạng thái hoạt động của người dùng.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>

    <form class="card p-3 mb-4" method="get" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
        <div class="row g-2 align-items-end">
            <div class="col-lg-4">
                <label class="form-label small text-muted" for="Keyword">Tìm kiếm</label>
                <input id="Keyword" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Họ tên, email hoặc số điện thoại" />
            </div>
            <div class="col-sm-4 col-lg-2">
                <label class="form-label small text-muted" for="RoleFilter">Vai trò</label>
                <select id="RoleFilter" name="RoleFilter" class="form-select">
                    <option value="All" selected="@(Model.RoleFilter == "All")">Tất cả</option>
                    <option value="Admin" selected="@(Model.RoleFilter == AppConstants.Roles.Admin)">Admin</option>
                    <option value="Owner" selected="@(Model.RoleFilter == AppConstants.Roles.Owner)">Owner</option>
                    <option value="Customer" selected="@(Model.RoleFilter == AppConstants.Roles.Customer)">Customer</option>
                </select>
            </div>
            <div class="col-sm-4 col-lg-3">
                <label class="form-label small text-muted" for="StatusFilter">Trạng thái</label>
                <select id="StatusFilter" name="StatusFilter" class="form-select">
                    <option value="All" selected="@(Model.StatusFilter == "All")">Tất cả</option>
                    <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang hoạt động</option>
                    <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Đã khóa</option>
                    <option value="TemporarilyLocked" selected="@(Model.StatusFilter == "TemporarilyLocked")">Khóa tạm thời</option>
                </select>
            </div>
            <div class="col-sm-4 col-lg-3 d-grid">
                <button class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc</button>
            </div>
        </div>
    </form>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr><th>Người dùng</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr>
                </thead>
                <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Không có dữ liệu phù hợp.</td></tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@user.FullName</div>
                            <div class="small text-muted">@user.Email</div>
                            @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                            {
                                <div class="small text-muted">@user.PhoneNumber</div>
                            }
                        </td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge text-bg-light border me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (!user.IsActive)
                            {
                                <span class="badge text-bg-danger">Đã khóa</span>
                            }
                            else if (user.IsTemporarilyLocked)
                            {
                                <span class="badge text-bg-warning">Khóa tạm thời</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Hoạt động</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td><a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="UserManagement" asp-action="Detail" asp-route-id="@user.Id">Chi tiết</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, TotalResults = Model.TotalCount, PageSize = Model.PageSize, Controller = "UserManagement", Action = "Index", Area = "Admin", ItemLabel = "tài khoản", RouteValues = routeValues })" />
</div>
