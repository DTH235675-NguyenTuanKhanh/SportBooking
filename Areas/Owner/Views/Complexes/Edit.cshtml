@model ComplexEditViewModel
@{
    var creating = ViewContext.RouteData.Values["action"]?.ToString() == "Create";
    ViewData["Title"] = creating ? "Thêm cụm sân" : "Sửa cụm sân";
}
<div class="container py-4">
    <a asp-action="Index" class="text-decoration-none">← Danh sách cụm sân</a>
    <h1 class="h3 mt-3 mb-4">@ViewData["Title"]</h1>
    <form method="post" class="card p-4" asp-action="@(creating ? "Create" : "Edit")" asp-route-id="@ViewContext.RouteData.Values["id"]">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="200" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" maxlength="300" /><span asp-validation-for="Address" class="text-danger"></span></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Province" class="form-label"></label><input asp-for="Province" class="form-control" maxlength="100" /><span asp-validation-for="Province" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="District" class="form-label"></label><input asp-for="District" class="form-control" maxlength="100" /><span asp-validation-for="District" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" maxlength="20" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" maxlength="256" /><span asp-validation-for="Email" class="text-danger"></span></div>
            @* Input time mặc định theo phút. jQuery Validation không xử lý thuộc tính step cho type time. *@
            <div class="col-md-6 mb-3"><label asp-for="OpeningTime" class="form-label"></label><input asp-for="OpeningTime" type="time" asp-format="{0:hh\:mm}" class="form-control" /><span asp-validation-for="OpeningTime" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="ClosingTime" class="form-label"></label><input asp-for="ClosingTime" type="time" asp-format="{0:hh\:mm}" class="form-control" /><span asp-validation-for="ClosingTime" class="text-danger"></span></div>
        </div>
        <p class="form-text mt-0">Giờ mở và đóng cửa trong cùng ngày; có thể để trống cả hai. Thông tin này không tự thay đổi khung giờ của sân con.</p>
        <div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" type="url" class="form-control" maxlength="500" placeholder="https://..." /><span asp-validation-for="ImageUrl" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" maxlength="1000"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label>
            <div class="form-text">Ngừng hoạt động sẽ ngăn đặt mới các sân thuộc cụm. Các lịch đặt hiện có vẫn được giữ lại để xử lý.</div>
        </div>
        <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">Lưu cụm sân</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
