@model OwnerCourtListViewModel
@{ ViewData["Title"] = "Quản lý sân trong cụm"; }
<div class="container py-4">
    <a asp-controller="Complexes" asp-action="Index">← Danh sách cụm sân</a>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 my-4">
        <div><h1 class="h3">Sân trong @Model.ComplexName</h1><p class="text-muted mb-0">Quản lý thông tin và trạng thái các sân thuộc cụm.</p></div>
        <a asp-action="Create" asp-route-complexId="@Model.ComplexId" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Thêm sân</a>
    </div>
    @if (!Model.ComplexIsActive)
    {
        <div class="alert alert-warning" role="alert">Cụm sân đang ngừng hoạt động. Khách chưa thể đặt mới dù sân con có trạng thái Hoạt động.</div>
    }
    <form method="get" class="card p-3 mb-4">
        <input type="hidden" name="complexId" value="@Model.ComplexId" />
        <div class="row g-3 align-items-end">
            <div class="col-md-6"><label for="keyword" class="form-label">Tìm sân</label><input id="keyword" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tên sân hoặc loại sân" /></div>
            <div class="col-md-3"><label for="status" class="form-label">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả</option>@foreach (var status in Enum.GetValues<CourtStatus>()) { <option value="@status" selected="@(Model.Status == status)">@OwnerCourtListViewModel.StatusText(status)</option> }</select></div>
            <div class="col-md-3 d-flex gap-2"><button class="btn btn-primary">Lọc</button><a asp-action="Index" asp-route-complexId="@Model.ComplexId" class="btn btn-outline-secondary">Đặt lại</a></div>
        </div>
    </form>
    @if (Model.Items.Count == 0)
    {
        <div class="card text-center p-5"><h2 class="h5">Chưa có sân phù hợp</h2><p class="text-muted mb-0">Thêm sân vào cụm hoặc thay đổi bộ lọc.</p></div>
    }
    else
    {
        <div class="card table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="px-3">@Model.TotalCount sân trong cụm.</caption>
                <thead><tr><th scope="col">Tên sân</th><th scope="col">Loại sân</th><th scope="col">Khung giờ hoạt động</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
                <tbody>
                    @foreach (var court in Model.Items)
                    {
                        <tr><td><strong>@court.Name</strong></td><td>@court.SportTypeName</td><td>@court.TimeSlotCount</td><td><span class="badge @(court.Status == CourtStatus.Active ? "text-bg-success" : court.Status == CourtStatus.Maintenance ? "text-bg-warning" : "text-bg-secondary")">@OwnerCourtListViewModel.StatusText(court.Status)</span></td><td><div class="d-flex gap-2 flex-wrap"><a asp-controller="TimeSlots" asp-action="Index" asp-route-courtId="@court.Id" class="btn btn-primary btn-sm" aria-label="Khung giờ của @court.Name">Khung giờ và giá</a><a asp-action="Edit" asp-route-complexId="@Model.ComplexId" asp-route-id="@court.Id" class="btn btn-sm btn-outline-primary" aria-label="Sửa @court.Name">Chỉnh sửa</a><form method="post" asp-action="Delete" asp-route-complexId="@Model.ComplexId" asp-route-id="@court.Id" onsubmit="return confirm('Xóa sân @court.Name? Lịch sử đặt sân sẽ được giữ lại.');"><button class="btn btn-sm btn-outline-danger" aria-label="Xóa @court.Name">Xóa sân</button></form></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="~/Views/Shared/_Pagination.cshtml" model="@(new PaginationViewModel { Page = Model.Page, TotalPages = Model.TotalPages, TotalResults = Model.TotalCount, PageSize = 10, Controller = "Courts", Action = "Index", Area = "Owner", ItemLabel = "sân", RouteValues = new Dictionary<string, string?> { ["complexId"] = Model.ComplexId.ToString(), ["keyword"] = Model.Keyword, ["status"] = Model.Status?.ToString() } })" />
</div>
