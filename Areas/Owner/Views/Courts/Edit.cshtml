@model OwnerCourtEditViewModel
@{
    var creating = ViewContext.RouteData.Values["action"]?.ToString() == "Create";
    ViewData["Title"] = creating ? "Thêm sân" : "Sửa sân";
}
<div class="container py-4">
    <a asp-action="Index" asp-route-complexId="@Model.ComplexId">← Sân trong @Model.ComplexName</a>
    <h1 class="h3 mt-3 mb-4">@ViewData["Title"]</h1>
    <form method="post" class="card p-4" asp-action="@(creating ? "Create" : "Edit")" asp-route-complexId="@Model.ComplexId" asp-route-id="@ViewContext.RouteData.Values["id"]">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" maxlength="150" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="SportTypeId" class="form-label"></label>
                <select asp-for="SportTypeId" class="form-select">
                    <option value="">Chọn loại sân</option>
                    @foreach (var type in Model.SportTypes)
                    {
                        <option value="@type.Id">@type.Name@(!type.IsActive ? " (Ngừng hoạt động)" : "")</option>
                    }
                </select>
                <span asp-validation-for="SportTypeId" class="text-danger"></span>
                <div class="form-text">Loại đã ngừng hoạt động chỉ được giữ lại cho sân đang sử dụng loại đó.</div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var status in Enum.GetValues<CourtStatus>())
                    {
                        <option value="@status">@OwnerCourtListViewModel.StatusText(status)</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
        </div>
        @if (Model.SportTypes.Count == 0)
        {
            <div class="alert alert-warning" role="alert">Chưa có loại sân đang hoạt động. Vui lòng liên hệ Admin bổ sung danh mục trước khi tạo sân.</div>
        }
        <div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" maxlength="500" aria-describedby="image-help" /><span asp-validation-for="ImageUrl" class="text-danger"></span><div id="image-help" class="form-text">URL http/https hoặc đường dẫn ảnh bắt đầu bằng /uploads/.</div></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4" maxlength="1000"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
        <div class="alert alert-info">Bảo trì hoặc ngừng hoạt động sẽ chặn đặt mới; các lịch đặt hiện có vẫn được giữ lại. Sau khi lưu sân, chọn Khung giờ và giá để cấu hình lịch bán.</div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Lưu sân</button><a asp-action="Index" asp-route-complexId="@Model.ComplexId" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
