@model OwnerReviewList
@{
    ViewData["Title"] = "Đánh giá sân";
}
<div class="container py-4">
    <h1 class="h3 mb-3">Đánh giá sân</h1>
    @if (Model.Reviews.Count == 0)
    {
        <div class="card p-4"><p class="mb-0">Chưa có đánh giá cho sân của bạn.</p></div>
    }
    <div class="d-grid gap-3">
        @foreach (var review in Model.Reviews)
        {
            <article class="card p-3 p-md-4">
                <div class="d-flex flex-wrap gap-2 justify-content-between">
                    <h2 class="h5 mb-0 text-break">@review.Court</h2>
                    <span class="fw-semibold text-warning">@review.Rating/5 sao</span>
                </div>
                <p class="small text-muted text-break mb-2">@review.Complex · @review.BookingCode @(review.CourtDeleted ? "· Sân đã xóa mềm" : "")</p>
                <p class="mb-1 fw-semibold text-break">@review.Customer</p>
                <p class="text-break mb-2">@review.Comment</p>
                @if (review.Reply is not null)
                {
                    <div class="border rounded p-3 mb-2">
                        <p class="fw-semibold mb-1">Phản hồi của bạn @if (review.ReplyAt is { } at) { <span class="text-muted small">· @at.AddHours(7).ToString("dd/MM/yyyy HH:mm")</span> }</p>
                        <p class="text-break mb-0">@review.Reply</p>
                    </div>
                }
                @if (review.Visible)
                {
                    <a class="btn btn-outline-primary align-self-start mt-2" asp-action="Reply" asp-route-id="@review.Id">
                        @(review.Reply is null ? "Phản hồi" : "Sửa phản hồi")
                    </a>
                }
                else
                {
                    <p class="small text-muted mb-0">Đánh giá đã được Admin ẩn.</p>
                }
            </article>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="d-flex align-items-center gap-2 mt-3" aria-label="Trang đánh giá">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-primary" asp-route-page="@(Model.Page - 1)">Trang trước</a>
            }
            <span>Trang @Model.Page/@Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a class="btn btn-outline-primary" asp-route-page="@(Model.Page + 1)">Trang sau</a>
            }
        </nav>
    }
</div>
