@{
    var errors = ViewData.ModelState
        .SelectMany(entry => entry.Value!.Errors.Select(error => new { Key = entry.Key, Text = error.ErrorMessage }))
        .ToList();
}
<div id="bookingErrors" class="alert alert-danger form-error-summary" role="alert" tabindex="-1"
     aria-labelledby="bookingErrorTitle" hidden="@(errors.Count == 0)">
    <h2 class="h6" id="bookingErrorTitle">Vui lòng kiểm tra lại thông tin đặt sân</h2>
    <ul class="mb-0">
        @foreach (var error in errors)
        {
            var target = error.Key == "SelectedTimeSlotIds" ? "timeSlotGrid"
                : error.Key == "PaymentMethod" ? "paymentChoices"
                : string.IsNullOrEmpty(error.Key) ? "bookingForm" : error.Key;
            <li><a href="#@target">@error.Text</a></li>
        }
    </ul>
</div>
