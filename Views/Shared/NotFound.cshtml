@* File: Views/Shared/NotFound.cshtml
   Trang 404 - được render bởi HomeController.Error(404). *@
@{
    ViewData["Title"] = "Không tìm thấy trang";
    ViewData["MetaDescription"] = "Trang bạn truy cập không tồn tại.";
}

<div class="container">
    <div class="error-page">
        <div class="error-code">404</div>
        <h1 class="h3 mb-2">Không tìm thấy trang bạn cần</h1>
        <p class="text-muted mb-4">
            Đường dẫn có thể đã thay đổi, sân đã ngừng hoạt động, hoặc lịch đặt không còn tồn tại.
        </p>

        <form class="search-bar mx-auto mb-4" style="max-width: 560px"
              asp-controller="Court" asp-action="Search" method="get" role="search">
            <div class="input-group">
                <input type="search" class="form-control" name="Keyword"
                       placeholder="Tìm tên sân, cụm sân, khu vực..." aria-label="Tìm sân" />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i> Tìm sân
                </button>
            </div>
        </form>

        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i> Về trang chủ
            </a>
            <a class="btn btn-outline-primary" asp-controller="Court" asp-action="Search">
                <i class="bi bi-search"></i> Tìm sân thể thao
            </a>
            <a class="btn btn-outline-secondary" asp-controller="Booking" asp-action="MyBookings">
                <i class="bi bi-calendar-check"></i> Lịch đặt của tôi
            </a>
        </div>
    </div>
</div>
