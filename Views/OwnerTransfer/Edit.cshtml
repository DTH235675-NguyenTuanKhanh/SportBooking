@model TransferProfileInput
@{
    ViewData["Title"] = "Thông tin chuyển khoản";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <a class="btn btn-outline-secondary mb-3" asp-controller="Profile" asp-action="Index">Về hồ sơ</a>
            <h1 class="h3 mb-3">Thông tin chuyển khoản</h1>
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="card p-3 p-md-4" data-qr-submit>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <partial name="_TransferProfileFields" model="Model" />
                <button class="btn btn-primary align-self-start" type="submit">Lưu thông tin chuyển khoản</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/bank-transfer.js" asp-append-version="true" defer></script>
}
