@* File: Views/Account/ResetPasswordConfirmation.cshtml *@
@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="auth-container">
    <div class="auth-card card">
        <div class="card-body text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h2 class="mb-3">Đặt lại mật khẩu thành công!</h2>
            <p class="text-secondary mb-4">
                Mật khẩu của bạn đã được cập nhật.
                Bạn có thể đăng nhập ngay với mật khẩu mới.
            </p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
            </a>
        </div>
    </div>
</div>