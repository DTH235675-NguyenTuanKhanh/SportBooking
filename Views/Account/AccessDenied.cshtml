@* File: Views/Account/AccessDenied.cshtml *@
@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<div class="auth-container">
    <div class="auth-card card">
        <div class="card-body text-center">
            <div class="mb-4">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="mb-3">Truy cập bị từ chối</h2>
            <p class="text-secondary mb-4">
                Bạn không có quyền truy cập trang này.
                Vui lòng đăng nhập với tài khoản có quyền phù hợp.
            </p>
            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-house"></i> Trang chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>