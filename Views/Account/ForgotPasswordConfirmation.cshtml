@* File: Views/Account/ForgotPasswordConfirmation.cshtml *@
@{
    ViewData["Title"] = "Email đã được gửi";
}

<div class="auth-container">
    <div class="auth-card card">
        <div class="card-body text-center">
            <div class="mb-4">
                <i class="bi bi-envelope-check-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h2 class="mb-3">Kiểm tra email của bạn</h2>
            <p class="text-secondary mb-4">
                Chúng tôi đã gửi link đặt lại mật khẩu đến email của bạn.
                Vui lòng kiểm tra hộp thư và làm theo hướng dẫn.
            </p>
            <div class="alert alert-info text-start small">
                <i class="bi bi-info-circle-fill"></i>
                <strong>Lưu ý:</strong>
                <ul class="mb-0 mt-2">
                    <li>Link có hiệu lực trong <strong>24 giờ</strong></li>
                    <li>Nếu không thấy email, hãy kiểm tra thư mục <strong>Spam/Junk</strong></li>
                    <li>Có thể mất vài phút để email đến</li>
                </ul>
            </div>
            <div class="auth-links mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>