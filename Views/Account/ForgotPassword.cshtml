@* File: Views/Account/ForgotPassword.cshtml *@
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-container">
    <div class="auth-card card">
        <div class="card-body">
            <div class="auth-header">
                <div class="mb-3">
                    <i class="bi bi-key-fill text-primary" style="font-size: 3rem;"></i>
                </div>
                <h2>Quên mật khẩu?</h2>
                <p>Nhập email đã đăng ký, chúng tôi sẽ gửi link đặt lại mật khẩu cho bạn</p>
            </div>

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control" placeholder="email@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                    <i class="bi bi-send"></i> Gửi link đặt lại mật khẩu
                </button>

                @* Ghi chú dành cho môi trường phát triển: email không gửi thật mà in ra log. *@
                @if (ViewData["ShowDevHint"] as bool? == true)
                {
                    <div class="alert alert-warning small">
                        <i class="bi bi-console"></i>
                        <strong>Chế độ phát triển:</strong> email không được gửi thật.
                        Link đặt lại mật khẩu được in ra <strong>console/log</strong> của ứng dụng
                        (tìm dòng có chữ <code>LINK ĐẶT LẠI MẬT KHẨU</code>).
                    </div>
                }

                <div class="auth-links">
                    <a asp-controller="Account" asp-action="Login">
                        <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}